# MySQL 8+
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=finsight_intelligence
MYSQL_USER=finsight_user
MYSQL_PASSWORD=

# API local
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8501
API_TOKEN=

# Nhập tên model mà tài khoản có quyền generateContent
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TEMPERATURE=0.2
MAX_GEMINI_CALLS=24
GEMINI_OUTPUT_TOKENS=1800

# Brave
SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
BRAVE_WEB_SEARCH_ENABLED=true
BRAVE_LLM_CONTEXT_ENABLED=true
SEARCH_FALLBACK_ENABLED=false
BRAVE_COUNTRY=US
BRAVE_SEARCH_LANG=en
BRAVE_RESULTS_PER_QUERY=6
BRAVE_LLM_CONTEXT_MAX_TOKENS=4096
BRAVE_CONTEXT_THRESHOLD=balanced
MAX_SEARCH_REQUESTS_PER_RUN=16
BRAVE_REQUESTS_PER_SECOND=1
SEARCH_TIER_LIMITS=[2,2,2,2,2,2]

# SEC cần tên ứng dụng và email liên hệ thực
SEC_USER_AGENT=
SEC_TIMEOUT_SECONDS=15
# Chỉ dùng các host cụ thể, không dùng wildcard. Chỉ thêm vào PERSIST khi có quyền lưu và gửi cho Gemini.
ALLOWED_SOURCE_HOSTS=[]
PERSIST_SOURCE_HOSTS=[]
MARKET_ENABLED=true
# Bật khi có quyền lưu dữ liệu Yahoo và kết quả dẫn xuất.
PERSIST_MARKET=false

# RAG / runtime
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_ENABLED=true
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=8
MAX_AGENT_ROUNDS=1
MAX_ANALYSIS_SECONDS=300
NUMERIC_RELATIVE_TOLERANCE=0.001
PDF_FONT_PATH=

# Tuy chon: bo dau # va dien don gia USD cua goi dang dung.
# BRAVE_WEB_USD_PER_1000=
# BRAVE_CONTEXT_USD_PER_1000=
# GEMINI_INPUT_USD_PER_MILLION=
# GEMINI_OUTPUT_USD_PER_MILLION=

# Dieu tiet so luot goi Gemini, mac dinh phu hop gioi han 15 luot/phut.
GEMINI_REQUESTS_PER_MINUTE=12
